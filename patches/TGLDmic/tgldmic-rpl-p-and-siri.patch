From 64b33fb65ea8fb70bc2fa83902b37294e8dfa9e6 Mon Sep 17 00:00:00 2001
From: vikenzo196 <vikenzo196@users.noreply.github.com>
Date: Sun, 15 Nov 2026 02:20:21 +0100
Subject: [PATCH 1/3] Add Raptor Lake-P Smart Sound DSP (8086:51CA, 51CB)

Raptor Lake-P uses the same Intel-signed SOF image as Alder Lake
(sof-rpl.ri and sof-adl.ri are byte-identical in sof-bin v2.6.1), so
it is handled as the Alder Lake family.

Tested on a Samsung Galaxy Book3 Ultra (i9-13900H, 8086:51CA, ALC298,
2 PDM mics) on macOS Tahoe 26.7.3 with AppleHDA (SimpleHDA + AppleALC):
the bundled sof-adl.ri v2.2 reaches FW_READY, capture runs at 48 kHz on
ch0/ch1, and the Core Audio plug-in records speech.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NfAuppim1uWtowz2V2mPaY
---
 kext/TGLDmic/Info.plist  | 2 +-
 kext/TGLDmic/TGLDmic.cpp | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/kext/TGLDmic/Info.plist b/kext/TGLDmic/Info.plist
index aa66db1..7c616b8 100644
--- a/kext/TGLDmic/Info.plist
+++ b/kext/TGLDmic/Info.plist
@@ -31,7 +31,7 @@
 			<key>IOProviderClass</key>
 			<string>IOPCIDevice</string>
 			<key>IOPCIPrimaryMatch</key>
-			<string>0x02c88086 0x9dc88086 0xa3488086 0x06c88086 0xa0c88086 0x43c88086 0x34c88086 0x51c88086 0x51cc8086 0x51c98086 0x51cd8086</string>
+			<string>0x02c88086 0x9dc88086 0xa3488086 0x06c88086 0xa0c88086 0x43c88086 0x34c88086 0x51c88086 0x51cc8086 0x51c98086 0x51cd8086 0x51ca8086 0x51cb8086</string>
 			<key>IOProbeScore</key>
 			<integer>100</integer>
 			<key>IOUserClientClass</key>
diff --git a/kext/TGLDmic/TGLDmic.cpp b/kext/TGLDmic/TGLDmic.cpp
index 2b9081b..3632078 100644
--- a/kext/TGLDmic/TGLDmic.cpp
+++ b/kext/TGLDmic/TGLDmic.cpp
@@ -123,6 +123,8 @@ IOService *TGLDmic::probe(IOService *provider, SInt32 *score) {
         case 0x51CC: // Alder Lake-P/U Smart Sound DSP (native)
         case 0x51C9: // Alder Lake-M
         case 0x51CD: // Alder Lake-S
+        case 0x51CA: // Raptor Lake-P Smart Sound DSP (same Intel-signed SOF image as ADL)
+        case 0x51CB: // Raptor Lake-P
             platformFamily = kPlatformAlderLake;
             break;
 
