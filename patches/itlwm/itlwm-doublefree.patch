+            /* Free only our own buffer; another path may already have. */
+            IOLockLock(lk);
+            if (my_resp != NULL && sc->sc_cmd_resp_pkt[idx] == my_resp) {
+                ::free(my_resp);
+                sc->sc_cmd_resp_pkt[idx] = NULL;
+            }
+            IOLockUnlock(lk);
         }
     }
 out:
